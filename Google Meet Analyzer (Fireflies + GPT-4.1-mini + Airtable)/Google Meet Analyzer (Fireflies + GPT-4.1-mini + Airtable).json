      "id": "7a16fce9-c8aa-4320-bf31-4a326c243b87",
      "name": "Fetch Transcript from Fireflies"
    },
    {
      "parameters": {
        "jsCode": "\n// Convert Fireflies sentences array into a clean transcript text\nconst data = $json.data || {};\nconst transcript = data.transcript || {};\nconst sentences = transcript.sentences || [];\n\n// Build full transcript text: \"Speaker: text\"\nconst transcriptText = sentences\n  .map(s => `${s.speaker_name || 'Unknown'}: ${s.raw_words || ''}`)\n  .join('\\n');\n\nconst meetingTitle = transcript.title || 'Google Meet Call';\nconst summary = transcript.summary || {};\n\nreturn [{\n  json: {\n    text: transcriptText,\n    meetingTitle,\n    actionItems: summary.action_items || '',\n    overview: summary.overview || ''\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
