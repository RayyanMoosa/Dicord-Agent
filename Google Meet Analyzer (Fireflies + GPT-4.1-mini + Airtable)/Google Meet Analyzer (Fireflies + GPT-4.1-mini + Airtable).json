      "id": "5cf6bd06-1364-4411-a545-6439ce864efd",
      "name": "Fireflies Webhook",
      "webhookId": "fireflies-webhook"
    },
    {
      "parameters": {
        "jsCode": "// n8n's Webhook node always wraps the incoming HTTP request as:\n//   { headers, params, query, body }\n// Fireflies posts a JSON body with one of two shapes:\n//   v1: { meetingId, eventType, clientReferenceId? }\n//   v2: { event, timestamp, meeting_id, client_reference_id? }\n// Some manual test tools (curl, Postman) may send the fields at the top level\n// of the n8n item, so we fall back to $json itself if .body is absent.\n\nconst raw = $input.first().json;\nconst body = (raw && typeof raw.body === 'object' && raw.body !== null) ? raw.body : raw;\n\n// Search every key Fireflies (or a manual test) might use, in order of preference.\nconst meetingId =\n  body.meetingId ||\n  body.meeting_id ||\n  body.transcriptId ||\n  body.transcript_id ||\n  body.id ||\n  body.data?.meetingId ||\n  body.data?.meeting_id ||\n  body.data?.transcriptId ||\n  body.data?.transcript_id ||\n  body.data?.id ||\n  body.payload?.meeting_id ||\n  body.payload?.meetingId ||\n  '';\n\nif (!meetingId) {\n  // Fail loudly so we never call Fireflies with an empty ID (which produces\n  // the misleading 'POST body missing, invalid Content-Type, or JSON object\n  // has no keys' error from the GraphQL endpoint).\n  throw new Error(\n    'Could not find a meeting/transcript ID in the Fireflies webhook payload. ' +\n    'Raw body received: ' + JSON.stringify(body)\n  );\n}\n\nconst eventType = body.event || body.eventType || '';\nconst title = body.title || body.data?.title || 'Untitled Meeting';\nconst date = body.date || body.data?.date || new Date().toISOString();\n\nreturn [{\n  json: {\n    meetingId,\n    eventType,\n    title,\n    date,\n    rawBody: body\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        -16
      ],
      "id": "c41d7bfb-0b71-4553-be69-fc940182e091",
      "name": "Extract Meeting ID"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.fireflies.ai/graphql",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_FIREFLIES_API_KEY"
            },
            {
